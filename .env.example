# Bangalore Voice Nav - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to git!

# -------------------------------------------------------------
# Gnani.ai API Configuration (Prisma STT & Timbre TTS)
# -------------------------------------------------------------
GNANI_API_KEY=your_gnani_api_key_here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# -------------------------------------------------------------
# TomTom Traffic API Configuration (Real-Time Traffic & Guidance)
# -------------------------------------------------------------
TOMTOM_API_KEY=your_tomtom_api_key_here
TRAFFIC_DAILY_CAP=400

# -------------------------------------------------------------
# Application Environment
# -------------------------------------------------------------
APP_ENV=dev
PORT=8000

